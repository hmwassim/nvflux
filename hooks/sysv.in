#!/bin/sh
### BEGIN INIT INFO
# Provides:          nvflux
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Apply the saved nvflux GPU clock mode
### END INIT INFO
case "$1" in
start) exec @BINDIR@/nvflux reload --wait 15 ;;
stop|restart|reload|force-reload|status) exit 0 ;;
*) echo "usage: $0 start" >&2; exit 3 ;;
esac
